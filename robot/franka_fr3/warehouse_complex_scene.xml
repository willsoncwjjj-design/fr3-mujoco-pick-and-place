<mujoco>
    <include file="fr3.xml"/>
    <compiler angle="radian" autolimits="true"/>
    <option timestep="0.002" gravity="0 0 -9.81"/>

    <asset>
        <texture name="grid" type="2d" builtin="checker"
                 width="800" height="800" rgb1=".2 .4 .5" rgb2=".3 .5 .6"/>
        <material name="grid" texture="grid" texrepeat="1 1" reflectance=".2"/>
        <material name="table" rgba="0.6 0.4 0.2 1"/>
    </asset>

    <worldbody>
        <light diffuse="0.9 0.9 0.9" pos="0 0 5" dir="0 0 -1"/>
        <camera name="top_cam" pos="0.25 0 2.3"
                xyaxes="1 0 0 0 1 0" fovy="45"/>
        <geom type="plane" size="2 2 0.1" material="grid"/>

        <body name="table" pos="0.25 0 0.8">
            <geom type="box" size="0.4 0.4 0.02"
                  material="table" contype="1" conaffinity="1"/>
        </body>

        <body name="priority_bin_slot_1" pos="0.30 -0.18 0.825">
            <geom type="box" size="0.06 0.06 0.005"
                  rgba="0.95 0.55 0.15 1" contype="0" conaffinity="0"/>
        </body>
        <body name="standard_bin_slot_1" pos="0.46 -0.18 0.825">
            <geom type="box" size="0.06 0.06 0.005"
                  rgba="0.15 0.65 0.95 1" contype="0" conaffinity="0"/>
        </body>
        <body name="buffer_slot_1" pos="0.52 0.12 0.825">
            <geom type="box" size="0.06 0.06 0.005"
                  rgba="0.25 0.80 0.45 1" contype="0" conaffinity="0"/>
        </body>

        <body name="cube_red" pos="0.30 0.15 0.85">
            <freejoint/>
            <geom type="box" size="0.03 0.03 0.03"
                  rgba="0.8 0.2 0.2 1" contype="1" conaffinity="1"
                  friction="0.5 0.005 0.0001"/>
        </body>

        <body name="cube_blue" pos="0.30 -0.18 0.84">
            <freejoint/>
            <geom type="box" size="0.04 0.04 0.02"
                  rgba="0.2 0.4 0.9 1" contype="1" conaffinity="1"
                  friction="0.5 0.005 0.0001"/>
        </body>
    </worldbody>

    <contact>
        <exclude body1="table" body2="fr3_link0"/>
    </contact>
</mujoco>
